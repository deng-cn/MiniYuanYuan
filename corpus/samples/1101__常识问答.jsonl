{"id": "1101-常识问答-000001", "turns": [{"role": "user", "text": "怎么用影子判断太阳方位"}, {"role": "assistant", "text": "影子方向跟太阳相反，影子朝西太阳就在东边，影子朝东太阳就在西边。"}]}
{"id": "1101-常识问答-000002", "turns": [{"role": "user", "text": "太阳从哪边落下"}, {"role": "assistant", "text": "太阳从西边落下。"}]}
{"id": "1101-常识问答-000003", "turns": [{"role": "user", "text": "太阳为什么早上升起晚上落下"}, {"role": "assistant", "text": "其实是地球在自转，我们跟着地球转，才觉得太阳东升西落。"}]}
{"id": "1101-常识问答-000004", "turns": [{"role": "user", "text": "一年里哪天太阳最早下山"}, {"role": "assistant", "text": "北半球是冬至那天，太阳下山最早。"}]}
{"id": "1101-常识问答-000005", "turns": [{"role": "user", "text": "日出和日落时间为什么不一样"}, {"role": "assistant", "text": "因为地球轨道是椭圆的，加上地轴倾斜，每天太阳走的路线长短不一样。"}]}
{"id": "1101-常识问答-000006", "turns": [{"role": "user", "text": "怎么判断太阳升起的方向"}, {"role": "assistant", "text": "早上看太阳升起的方向就是东方，或者看影子，影子朝西就是东边。"}]}
{"id": "1101-常识问答-000007", "turns": [{"role": "user", "text": "早上起来太阳在左边还是右边"}, {"role": "assistant", "text": "面朝太阳升起的方向，太阳就在你正前方，不在左右边。"}]}
{"id": "1101-常识问答-000008", "turns": [{"role": "user", "text": "一天中太阳光最刺眼的时候是啥时候"}, {"role": "assistant", "text": "一般是中午前后，太阳最高的时候光线最强最刺眼。"}]}
{"id": "1101-常识问答-000009", "turns": [{"role": "user", "text": "太阳从哪边升起"}, {"role": "assistant", "text": "太阳从东边升起。"}]}
{"id": "1101-常识问答-000010", "turns": [{"role": "user", "text": "太阳为什么东升西落"}, {"role": "assistant", "text": "因为地球自西向东自转，所以看起来太阳东升西落。"}]}
{"id": "1101-常识问答-000011", "turns": [{"role": "user", "text": "一年中哪天太阳最早出来"}, {"role": "assistant", "text": "北半球夏至那天，也就是6月21日前后，太阳最早升起。"}]}
{"id": "1101-常识问答-000012", "turns": [{"role": "user", "text": "中午的太阳在哪个方向"}, {"role": "assistant", "text": "在北半球，中午的太阳一般在正南方向。"}]}
{"id": "1101-常识问答-000013", "turns": [{"role": "user", "text": "太阳落山时天为啥会变红"}, {"role": "assistant", "text": "因为阳光穿过更厚的大气层，蓝光被散射掉，剩下红光，所以天变红。"}]}
{"id": "1101-常识问答-000014", "turns": [{"role": "user", "text": "太阳升起和落下有什么区别"}, {"role": "assistant", "text": "升起时天由暗变亮，落下时天由亮变暗，方向正好相反。"}]}
{"id": "1101-常识问答-000015", "turns": [{"role": "user", "text": "为什么夏天天亮得早"}, {"role": "assistant", "text": "夏天北半球白天长，太阳升起得早，所以天亮得早。"}]}
{"id": "1101-常识问答-000016", "turns": [{"role": "user", "text": "太阳光有多少种颜色"}, {"role": "assistant", "text": "太阳光是白光，可以分解成红橙黄绿蓝靛紫七种颜色。"}]}
{"id": "1101-常识问答-000017", "turns": [{"role": "user", "text": "地球自转为什么会有白天黑夜？"}, {"role": "assistant", "text": "地球是个不透明的球体，自转时被太阳照到的一面是白天，背对太阳的一面是黑夜，转到哪边哪边就亮。"}]}
{"id": "1101-常识问答-000018", "turns": [{"role": "user", "text": "地球自转的方向是哪边？"}, {"role": "assistant", "text": "自西向东，从北极上空看是逆时针转，从南极上空看是顺时针转。"}]}
{"id": "1101-常识问答-000019", "turns": [{"role": "user", "text": "地球自转时南北极点会转吗？"}, {"role": "assistant", "text": "极点本身不移动，它就待在转轴上，只是随着地球绕着这个点转圈。"}]}
{"id": "1101-常识问答-000020", "turns": [{"role": "user", "text": "地球自转对我们的生活有什么影响？"}, {"role": "assistant", "text": "它带来了昼夜交替、日出日落，还让不同地方有时间差，也影响风向和洋流。"}]}
{"id": "1101-常识问答-000021", "turns": [{"role": "user", "text": "地球自转跟公转有什么区别？"}, {"role": "assistant", "text": "自转是地球绕自己转一圈约一天，公转是绕太阳转一圈约一年，自转产生昼夜，公转产生四季。"}]}
{"id": "1101-常识问答-000022", "turns": [{"role": "user", "text": "地球自转的速度在哪里最快？"}, {"role": "assistant", "text": "赤道最快，因为赤道周长最长，转一圈走的路最远，大约每秒465米。"}]}
{"id": "1101-常识问答-000023", "turns": [{"role": "user", "text": "地球自转一圈和一天有什么关系？"}, {"role": "assistant", "text": "自转一圈就是一个昼夜，也就是一天，约24小时。"}]}
{"id": "1101-常识问答-000024", "turns": [{"role": "user", "text": "地球自转一圈大约多少公里？"}, {"role": "assistant", "text": "大约4万公里，赤道周长约40075公里，转一圈走的距离就差不多是这个数。"}]}
{"id": "1101-常识问答-000025", "turns": [{"role": "user", "text": "周末是哪两天"}, {"role": "assistant", "text": "周末一般指周六和周日这两天。"}]}
{"id": "1101-常识问答-000026", "turns": [{"role": "user", "text": "工作日一共有几天"}, {"role": "assistant", "text": "一周的工作日一般是5天，也就是周一到周五。"}]}
{"id": "1101-常识问答-000027", "turns": [{"role": "user", "text": "双休日是怎么来的"}, {"role": "assistant", "text": "双休日是逐步推行的，从大小周到后来固定每周休两天，让打工人有更多休息时间。"}]}
{"id": "1101-常识问答-000028", "turns": [{"role": "user", "text": "周末和工作日有什么区别"}, {"role": "assistant", "text": "工作日要上班上学，周末休息，多数人不用打卡，可以自由安排时间。"}]}
{"id": "1101-常识问答-000029", "turns": [{"role": "user", "text": "七天怎么分成工作日和周末"}, {"role": "assistant", "text": "一周七天，周一到周五算工作日，周六和周日算周末。"}]}
{"id": "1101-常识问答-000030", "turns": [{"role": "user", "text": "一周哪天最忙通常"}, {"role": "assistant", "text": "通常周一最忙，刚上班要处理积压的事，节奏比较赶。"}]}
{"id": "1101-常识问答-000031", "turns": [{"role": "user", "text": "一年有几个月"}, {"role": "assistant", "text": "一年有12个月。"}]}
{"id": "1101-常识问答-000032", "turns": [{"role": "user", "text": "一个月到底有多少天啊"}, {"role": "assistant", "text": "一个月天数不一样，小月30天，大月31天，2月平年28天、闰年29天。"}]}
{"id": "1101-常识问答-000033", "turns": [{"role": "user", "text": "闰年和普通年有什么区别"}, {"role": "assistant", "text": "闰年有366天，二月有29天；平年只有365天，二月28天。"}]}
{"id": "1101-常识问答-000034", "turns": [{"role": "user", "text": "平年一年又只有多少天"}, {"role": "assistant", "text": "平年一年有365天。"}]}
{"id": "1101-常识问答-000035", "turns": [{"role": "user", "text": "闰年的二月二十九日能过生日吗"}, {"role": "assistant", "text": "能过，只是四年才轮到一次，通常在2月28日或3月1日补过。"}]}
{"id": "1101-常识问答-000036", "turns": [{"role": "user", "text": "闰年是怎么定下来的"}, {"role": "assistant", "text": "公历年份能被4整除是闰年，但整百年要能被400整除才是闰年。"}]}
{"id": "1101-常识问答-000037", "turns": [{"role": "user", "text": "一天有多少小时"}, {"role": "assistant", "text": "一天有24小时。"}]}
{"id": "1101-常识问答-000038", "turns": [{"role": "user", "text": "一分钟到底等于多少秒"}, {"role": "assistant", "text": "一分钟等于60秒。"}]}
{"id": "1101-常识问答-000039", "turns": [{"role": "user", "text": "为什么一天要分成24小时"}, {"role": "assistant", "text": "古埃及人把白天黑夜各分成12段，合起来就是24小时，一直沿用至今。"}]}
{"id": "1101-常识问答-000040", "turns": [{"role": "user", "text": "一小时怎么切成60分钟"}, {"role": "assistant", "text": "古代巴比伦用六十进制计数，把一小时分成60份，每份就是一分钟。"}]}
{"id": "1101-常识问答-000041", "turns": [{"role": "user", "text": "白天为什么也能看到月亮"}, {"role": "assistant", "text": "月亮本身不发光，靠反射太阳光。白天它离太阳不太近时，反射的光足够亮，就能在蓝天里看见。"}]}
{"id": "1101-常识问答-000042", "turns": [{"role": "user", "text": "地球围绕什么天体转"}, {"role": "assistant", "text": "地球围绕太阳转，同时自己也在自转。"}]}
{"id": "1101-常识问答-000043", "turns": [{"role": "user", "text": "月亮为什么绕着地球转呀"}, {"role": "assistant", "text": "因为地球对月亮有引力，把月亮拉住，月亮就绕着地球转了。"}]}
{"id": "1101-常识问答-000044", "turns": [{"role": "user", "text": "地球自转一圈要多久"}, {"role": "assistant", "text": "大约24小时，也就是一天。"}]}
{"id": "1101-常识问答-000045", "turns": [{"role": "user", "text": "太阳系里哪颗行星离地球最近"}, {"role": "assistant", "text": "金星是离地球最近的行星。"}]}
{"id": "1101-常识问答-000046", "turns": [{"role": "user", "text": "为什么白天看不见星星"}, {"role": "assistant", "text": "白天太阳光太强，把星星的微弱光芒盖住了，所以看不见。"}]}
{"id": "1101-常识问答-000047", "turns": [{"role": "user", "text": "一年四季是怎么形成的"}, {"role": "assistant", "text": "地球绕太阳转时地轴是倾斜的，阳光直射点在南北回归线之间移动，各地受热不同，就形成了四季。"}]}
{"id": "1101-常识问答-000048", "turns": [{"role": "user", "text": "月亮有没有自己的月亮"}, {"role": "assistant", "text": "没有，月亮是地球的卫星，它自己没有卫星。"}]}
{"id": "1101-常识问答-000049", "turns": [{"role": "user", "text": "地球和月亮有什么区别"}, {"role": "assistant", "text": "地球是行星，能自己发光发热、有生命；月亮是地球的卫星，本身不发光，靠反射太阳光，体积和质量都比地球小得多。"}]}
{"id": "1101-常识问答-000050", "turns": [{"role": "user", "text": "天上的星星到底是什么"}, {"role": "assistant", "text": "大部分星星是像太阳一样能发光发热的恒星，只是距离我们太远，看起来才只是一个亮点。"}]}
{"id": "1101-常识问答-000051", "turns": [{"role": "user", "text": "中国最长的河是哪条"}, {"role": "assistant", "text": "长江，全长约六千三百公里，是中国第一长河。"}]}
{"id": "1101-常识问答-000052", "turns": [{"role": "user", "text": "黄河为什么叫母亲河"}, {"role": "assistant", "text": "因为黄河流域是中华文明的重要发源地，孕育了早期的农业和华夏民族，所以被称为母亲河。"}]}
{"id": "1101-常识问答-000053", "turns": [{"role": "user", "text": "长江和黄河有什么区别"}, {"role": "assistant", "text": "长江更长、水量更大，流经南方；黄河较短、含沙量大，主要流经北方，两者发源地和入海口也不同。"}]}
{"id": "1101-常识问答-000054", "turns": [{"role": "user", "text": "黄河的水为什么是黄的"}, {"role": "assistant", "text": "因为黄河流经黄土高原，带走了大量泥沙，泥沙使河水呈现黄色。"}]}
{"id": "1101-常识问答-000055", "turns": [{"role": "user", "text": "长江从哪里发源到哪里入海"}, {"role": "assistant", "text": "长江发源于青藏高原的唐古拉山脉，自西向东流，最后注入东海。"}]}
{"id": "1101-常识问答-000056", "turns": [{"role": "user", "text": "中国第二长的河是哪条"}, {"role": "assistant", "text": "黄河，全长约五千四百公里，是中国第二长河。"}]}
{"id": "1101-常识问答-000057", "turns": [{"role": "user", "text": "太阳下山前天空为啥会变红"}, {"role": "assistant", "text": "因为阳光穿过大气层时，蓝光被散射掉了，剩下红橙色的光透过来，所以天空变红。"}]}
{"id": "1101-常识问答-000058", "turns": [{"role": "user", "text": "北方和南方看太阳升起位置有什么区别"}, {"role": "assistant", "text": "越往北，太阳升起的位置越偏北；越往南，升起位置越偏南，夏天差别更明显。"}]}
{"id": "1101-常识问答-000059", "turns": [{"role": "user", "text": "平年一年有多少天"}, {"role": "assistant", "text": "平年一年有365天。"}]}
{"id": "1101-常识问答-000060", "turns": [{"role": "user", "text": "闰年一年多少天"}, {"role": "assistant", "text": "闰年一年有366天。"}]}
{"id": "1101-常识问答-000061", "turns": [{"role": "user", "text": "为什么二月只有28天"}, {"role": "assistant", "text": "这是古罗马历法留下来的，后来闰年多加一天，平年就只有28天。"}]}
{"id": "1101-常识问答-000062", "turns": [{"role": "user", "text": "怎么判断是平年还是闰年"}, {"role": "assistant", "text": "年份能被4整除一般是闰年，但整百年要能被400整除才是闰年。"}]}
{"id": "1101-常识问答-000063", "turns": [{"role": "user", "text": "2024年是平年还是闰年"}, {"role": "assistant", "text": "2024年是闰年，全年366天。"}]}
{"id": "1101-常识问答-000064", "turns": [{"role": "user", "text": "农历一年有多少天"}, {"role": "assistant", "text": "农历平年约354天，闰年约384天，通过闰月来调节和公历的差距。"}]}
{"id": "1101-常识问答-000065", "turns": [{"role": "user", "text": "一天和一昼夜有什么区别"}, {"role": "assistant", "text": "一昼夜指从天黑到天亮再到天黑的完整周期，一天通常指24小时的自然日，日常使用中两者常混用。"}]}
{"id": "1101-常识问答-000066", "turns": [{"role": "user", "text": "闰年那天是不是多一个小时"}, {"role": "assistant", "text": "不是，闰年是2月多一天，多的是24小时；多一个小时的是夏令时切换那天。"}]}
{"id": "1101-常识问答-000067", "turns": [{"role": "user", "text": "什么时候一天会变成25小时"}, {"role": "assistant", "text": "夏令时开始的那天，时钟拨快一小时，那天实际只有23小时；拨慢那天才是25小时。"}]}
{"id": "1101-常识问答-000068", "turns": [{"role": "user", "text": "一整天的时间怎么合理安排"}, {"role": "assistant", "text": "把时间分成工作、学习、休息、运动和陪伴家人几块，重要事放在精力最好的上午，留出放松和睡眠时间。"}]}
{"id": "1101-常识问答-000069", "turns": [{"role": "user", "text": "哪个计时单位最大哪个最小"}, {"role": "assistant", "text": "常见计时单位里最大的是年，最小的是秒；更小的还有毫秒、微秒等。"}]}
{"id": "1101-常识问答-000070", "turns": [{"role": "user", "text": "一周有几天"}, {"role": "assistant", "text": "一周有7天。"}]}
{"id": "1101-常识问答-000071", "turns": [{"role": "user", "text": "一个星期从哪天开始算"}, {"role": "assistant", "text": "中国习惯把星期一当作一周的开始，国际上也有把周日或周一算作开始的。"}]}
{"id": "1101-常识问答-000072", "turns": [{"role": "user", "text": "为什么一周是七天不是八天"}, {"role": "assistant", "text": "源于古巴比伦人观察月相，约七天一个周期，后来被多种文化和宗教沿用固定下来。"}]}
{"id": "1101-常识问答-000073", "turns": [{"role": "user", "text": "月亮本身会发光吗"}, {"role": "assistant", "text": "不会，月亮本身不发光，我们看到的月光是它反射的太阳光。"}]}
{"id": "1101-常识问答-000074", "turns": [{"role": "user", "text": "月亮的光是从哪来的"}, {"role": "assistant", "text": "月亮的光是反射太阳光，它自己不发光。"}]}
{"id": "1101-常识问答-000075", "turns": [{"role": "user", "text": "为什么月亮会反射太阳光"}, {"role": "assistant", "text": "月亮表面的岩石和土壤能反射照过来的太阳光，所以看起来亮。"}]}
{"id": "1101-常识问答-000076", "turns": [{"role": "user", "text": "月亮自己会发热吗"}, {"role": "assistant", "text": "月亮自己不发热，白天被太阳晒会升温，晚上又会降温。"}]}
{"id": "1101-常识问答-000077", "turns": [{"role": "user", "text": "月亮为什么有时圆有时缺"}, {"role": "assistant", "text": "因为月亮绕地球转，我们看到被太阳照亮的部分多少不同，所以有圆有缺。"}]}
{"id": "1101-常识问答-000078", "turns": [{"role": "user", "text": "满月和新月有什么区别"}, {"role": "assistant", "text": "满月是月亮整个亮面朝向我们，看起来圆；新月是亮面背对我们，几乎看不见。"}]}
{"id": "1101-常识问答-000079", "turns": [{"role": "user", "text": "月亮离我们有多远"}, {"role": "assistant", "text": "月亮离地球大约38万公里，坐飞机要飞好几天。"}]}
{"id": "1101-常识问答-000080", "turns": [{"role": "user", "text": "月亮为什么不会掉下来"}, {"role": "assistant", "text": "月亮绕地球转的速度刚好，离心力和引力平衡，所以不会掉下来。"}]}
{"id": "1101-常识问答-000081", "turns": [{"role": "user", "text": "为什么二月只有二十八天"}, {"role": "assistant", "text": "古罗马历法里二月是最后一个月，被硬扣掉一天来凑全年天数，后来沿用下来就成了二十八天。"}]}
{"id": "1101-常识问答-000082", "turns": [{"role": "user", "text": "一年分几个季节怎么分的"}, {"role": "assistant", "text": "一般分四季：春、夏、秋、冬，按公历月份大致是3-5月、6-8月、9-11月、12-2月。"}]}
